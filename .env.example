# Copy to .env.stepfun.local, fill the key locally, and keep the file private.
# Do not commit a real key. Start with: python3 tools/launch.py --port 8769 --env-file .env.stepfun.local
# Uncomment the next line after replacing the placeholder.
# COURTLENS_STEPFUN_API_KEY=replace-with-your-account-key
COURTLENS_STEPFUN_API_VARIANT=step-plan
COURTLENS_STEPFUN_VISION_MODEL=step-3.7-flash
COURTLENS_STEPFUN_STORY_MODEL=step-3.7-flash
COURTLENS_STEPFUN_MODEL=stepaudio-2.5-tts
COURTLENS_STEPFUN_VOICE_ID=elegantgentle-female
