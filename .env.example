# Copy to .env.stepfun.local, fill the key locally, and keep the file private.
# Do not commit a real key. Start with: python3 tools/launch.py --port 8769 --env-file .env.stepfun.local
# Uncomment the next line after replacing the placeholder.
# COURTLENS_STEPFUN_API_KEY=replace-with-your-account-key
COURTLENS_STEPFUN_API_VARIANT=step-plan
COURTLENS_STEPFUN_VISION_MODEL=step-3.7-flash
COURTLENS_STEPFUN_STORY_MODEL=step-3.7-flash
COURTLENS_STEPFUN_MODEL=stepaudio-2.5-tts
COURTLENS_STEPFUN_VOICE_ID=boyinnansheng
# Three independent original stock voices; listen to generated films before claiming naturalness.
COURTLENS_STEPFUN_LANGUAGES=zh-CN,en-US,yue-HK
COURTLENS_STEPFUN_VOICE_ID_EN=vibrant-youth
COURTLENS_STEPFUN_VOICE_ID_YUE=shuangkuainansheng

# Bedrock defaults to text only; model names and parameter counts do not establish modalities.
# Set these only from the exact Portal/model documentation, then run each input-mode probe.
COURTLENS_BEDROCK_MODALITIES=text
COURTLENS_BEDROCK_TOOLS=0
# Visual evidence needs text,image plus tools=1; video-first also requires video.
# COURTLENS_BEDROCK_REGION=replace-with-allowed-region
# COURTLENS_STORY_MODEL_ID=replace-with-exact-text-model-id
# COURTLENS_SEMANTIC_MODEL_ID=replace-with-exact-video-model-id
# COURTLENS_VISION_MODEL_ID=replace-with-exact-image-model-id
