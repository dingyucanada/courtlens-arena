{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courtlens.local/contracts/broadcast-v1.json",
  "title": "CourtLens Broadcast v1",
  "description": "Source times are decoded presentation PTS seconds. Successful JSON responses wrap data; failures wrap ApiError. Writes require expectedRevision or If-Match.",
  "$defs": {
    "id": {"type":"string","pattern":"^[A-Za-z0-9_-]{1,80}$"},
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "time": {"type":"number","minimum":0},
    "point": {"type":"object","additionalProperties":false,"required":["x","y"],"properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1}}},
    "range": {"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"$ref":"#/$defs/time"},"end":{"$ref":"#/$defs/time"}}},
    "player": {"type":"object","additionalProperties":false,"required":["id","name","teamId","jersey","source","validOn"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"type":"string"},"teamId":{"$ref":"#/$defs/id"},"jersey":{"type":["string","null"]},"source":{"type":"string"},"validOn":{"type":["string","null"]}}},
    "source": {"type":"object","additionalProperties":false,"required":["label","kind","rightsNote","verified"],"properties":{"label":{"type":"string"},"kind":{"enum":["official-provided","user-provided","synthetic"]},"rightsNote":{"type":"string"},"verified":{"type":"boolean"}}},
    "media": {"type":"object","additionalProperties":false,"required":["id","sha256","filename","bytes","duration","width","height","timeBase","startPts","fpsNumerator","fpsDenominator","variableFrameRate","hasAudio","mediaUrl","posterUrl","source"],"properties":{"id":{"$ref":"#/$defs/id"},"sha256":{"$ref":"#/$defs/sha256"},"filename":{"type":"string"},"bytes":{"type":"integer","minimum":1},"duration":{"type":"number","exclusiveMinimum":0},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"timeBase":{"type":"string"},"startPts":{"type":"number"},"fpsNumerator":{"type":"integer","minimum":1},"fpsDenominator":{"type":"integer","minimum":1},"variableFrameRate":{"type":"boolean"},"hasAudio":{"type":"boolean"},"mediaUrl":{"type":"string"},"posterUrl":{"type":["string","null"]},"source":{"$ref":"#/$defs/source"}}},
    "frame": {"type":"object","additionalProperties":false,"required":["id","mediaSha256","requestedTime","actualTime","pts","timeBase","sha256","url","width","height"],"properties":{"id":{"$ref":"#/$defs/id"},"mediaSha256":{"$ref":"#/$defs/sha256"},"requestedTime":{"$ref":"#/$defs/time"},"actualTime":{"$ref":"#/$defs/time"},"pts":{"type":"number"},"timeBase":{"type":"string"},"sha256":{"$ref":"#/$defs/sha256"},"url":{"type":"string"},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1}}},
    "observation": {"type":"object","additionalProperties":false,"required":["id","type","start","end","anchorTime","segmentId","description","playerIds","unknownActors","frameIds","source","confidence","review","geometry"],"properties":{"id":{"$ref":"#/$defs/id"},"type":{"enum":["pass","shot","catch","movement","screen","result","other"]},"start":{"$ref":"#/$defs/time"},"end":{"$ref":"#/$defs/time"},"anchorTime":{"type":["number","null"],"minimum":0},"segmentId":{"$ref":"#/$defs/id"},"description":{"type":"string"},"playerIds":{"type":"array","items":{"$ref":"#/$defs/id"}},"unknownActors":{"type":"array","items":{"type":"string"}},"frameIds":{"type":"array","items":{"$ref":"#/$defs/id"}},"source":{"type":"object","additionalProperties":false,"required":["kind","runId","recordId"],"properties":{"kind":{"enum":["manual","model","cv"]},"runId":{"type":["string","null"]},"recordId":{"type":["string","null"]}}},"confidence":{"type":["number","null"],"minimum":0,"maximum":1},"review":{"type":"object","additionalProperties":false,"required":["status","actor","reason","at"],"properties":{"status":{"enum":["unreviewed","accepted","rejected"]},"actor":{"type":["string","null"]},"reason":{"type":["string","null"]},"at":{"type":["string","null"]}}},"geometry":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["space","points","validFrom","validTo","segmentId"],"properties":{"space":{"const":"screen-normalized"},"points":{"type":"array","minItems":2,"maxItems":20,"items":{"$ref":"#/$defs/point"}},"validFrom":{"$ref":"#/$defs/time"},"validTo":{"$ref":"#/$defs/time"},"segmentId":{"$ref":"#/$defs/id"}}}]}}},
    "observationBundle": {"type":"object","additionalProperties":false,"required":["schema","mediaSha256","providerRun","observations"],"properties":{"schema":{"const":"courtlens-observations/1"},"mediaSha256":{"$ref":"#/$defs/sha256"},"providerRun":{"type":"object","additionalProperties":false,"required":["id","provider","modelId","mode","requestHash","responseHash","startedAt","completedAt"],"properties":{"id":{"$ref":"#/$defs/id"},"provider":{"type":"string"},"modelId":{"type":["string","null"]},"mode":{"enum":["video-model","image-model","cv-executed","cv-imported","manual"]},"requestHash":{"$ref":"#/$defs/sha256"},"responseHash":{"$ref":"#/$defs/sha256"},"startedAt":{"type":"string"},"completedAt":{"type":"string"}}},"observations":{"type":"array","items":{"$ref":"#/$defs/observation"}}}},
    "binding": {"type":"object","additionalProperties":false,"required":["id","observationId","officialEventId","shotId","gameId","playerId","metricRecordIds","timeMapping","status","reason","confirmedBy","confirmedAt"],"properties":{"id":{"$ref":"#/$defs/id"},"observationId":{"$ref":"#/$defs/id"},"officialEventId":{"type":["string","null"]},"shotId":{"type":["string","null"]},"gameId":{"type":["string","null"]},"playerId":{"type":["string","null"]},"metricRecordIds":{"type":"array","items":{"$ref":"#/$defs/id"}},"timeMapping":{"type":"object","additionalProperties":false,"required":["source","videoTime","period","clock","mappingEvidenceIds"],"properties":{"source":{"enum":["video","game-clock"]},"videoTime":{"$ref":"#/$defs/time"},"period":{"type":["integer","null"]},"clock":{"type":["string","null"]},"mappingEvidenceIds":{"type":"array","items":{"$ref":"#/$defs/id"}}}},"status":{"enum":["proposed","confirmed","rejected"]},"reason":{"type":"string"},"confirmedBy":{"type":["string","null"]},"confirmedAt":{"type":["string","null"]}}},
    "beat": {"type":"object","additionalProperties":false,"required":["id","label","sourceStart","sourceEnd","anchorTime","observationIds","bindingIds","text","explanationKind","metricRecordId","secondaryLabel","annotation"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string"},"sourceStart":{"$ref":"#/$defs/time"},"sourceEnd":{"$ref":"#/$defs/time"},"anchorTime":{"$ref":"#/$defs/time"},"observationIds":{"type":"array","items":{"$ref":"#/$defs/id"}},"bindingIds":{"type":"array","items":{"$ref":"#/$defs/id"}},"text":{"type":"string"},"explanationKind":{"enum":["visible-fact","data-fact","interpretation"]},"metricRecordId":{"type":["string","null"]},"secondaryLabel":{"type":["string","null"]},"annotation":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["id","points","sourceObservationId","confirmedBy","confirmedAt"],"properties":{"id":{"$ref":"#/$defs/id"},"points":{"type":"array","minItems":2,"maxItems":20,"items":{"$ref":"#/$defs/point"}},"sourceObservationId":{"$ref":"#/$defs/id"},"confirmedBy":{"type":"string"},"confirmedAt":{"type":"string"}}}]}}},
    "story": {"type":"object","additionalProperties":false,"required":["schema","title","audience","sourceRange","beats"],"properties":{"schema":{"const":"courtlens-broadcast-story/1"},"title":{"type":"string"},"audience":{"enum":["fan","pro"]},"sourceRange":{"$ref":"#/$defs/range"},"beats":{"type":"array","minItems":1,"maxItems":3,"items":{"$ref":"#/$defs/beat"}}}},
    "review": {"type":"object","additionalProperties":false,"required":["contentHash","projectRevision","actor","at","checks","result","note"],"properties":{"contentHash":{"$ref":"#/$defs/sha256"},"projectRevision":{"type":"integer","minimum":0},"actor":{"type":"string"},"at":{"type":"string"},"checks":{"type":"object","additionalProperties":false,"required":["identity","timing","metrics","wording","geometry"],"properties":{"identity":{"type":"boolean"},"timing":{"type":"boolean"},"metrics":{"type":"boolean"},"wording":{"type":"boolean"},"geometry":{"type":"boolean"}}},"result":{"const":"approved"},"note":{"type":"string"}}},
    "error": {"type":"object","additionalProperties":false,"required":["code","message","retryable","fields","jobId"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"retryable":{"type":"boolean"},"fields":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","message"],"properties":{"path":{"type":"string"},"message":{"type":"string"}}}},"jobId":{"type":["string","null"]}}},
    "job": {"type":"object","additionalProperties":false,"required":["id","projectId","inputRevision","type","status","stage","startedAt","completedAt","progress","resultId","error","cacheHit"],"properties":{"id":{"$ref":"#/$defs/id"},"projectId":{"$ref":"#/$defs/id"},"inputRevision":{"type":"integer","minimum":0},"type":{"enum":["analyze","cv","render","probe-provider","ingest","frames","model-story"]},"status":{"enum":["queued","running","needs_review","succeeded","failed","cancelled","blocked"]},"stage":{"enum":["queued","probe","frames","infer","bind","draft","voice","render","verify","done","running","succeeded","failed","cancelled","blocked","needs_review"]},"startedAt":{"type":["string","null"]},"completedAt":{"type":["string","null"]},"progress":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["completed","total","unit"],"properties":{"completed":{"type":"number"},"total":{"type":"number"},"unit":{"type":"string"}}}]},"resultId":{"type":["string","null"]},"error":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/error"}]},"cacheHit":{"type":"boolean"},"result":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["frames"],"properties":{"frames":{"type":"array","items":{"$ref":"#/$defs/frame"}}}},{"type":"object","additionalProperties":false,"required":["projectId","projectRevision"],"properties":{"projectId":{"$ref":"#/$defs/id"},"projectRevision":{"type":"integer","minimum":0}}}]}}},
    "release": {"type":"object","additionalProperties":false,"required":["id","projectRevision","contentHash","createdAt","videoUrl","captionsUrl","manifestUrl","watchUrl","duration","videoSha256","voice","understanding"],"properties":{"id":{"$ref":"#/$defs/id"},"projectRevision":{"type":"integer","minimum":0},"contentHash":{"$ref":"#/$defs/sha256"},"createdAt":{"type":"string"},"videoUrl":{"type":"string"},"captionsUrl":{"type":"string"},"manifestUrl":{"type":"string"},"watchUrl":{"type":"string"},"duration":{"type":"number","exclusiveMinimum":0},"videoSha256":{"$ref":"#/$defs/sha256"},"voice":{"type":"object","additionalProperties":false,"required":["mode","provider","voiceId","audioSha256"],"properties":{"mode":{"enum":["silent","local-tts","minimax","stepfun","polly"]},"provider":{"type":["string","null"]},"voiceId":{"type":["string","null"]},"audioSha256":{"type":["string","null"]}}},"understanding":{"type":"object","additionalProperties":false,"required":["mode","providerRunIds","humanReviewed"],"properties":{"mode":{"enum":["manual","image-model","video-model","cv-assisted"]},"providerRunIds":{"type":"array","items":{"$ref":"#/$defs/id"}},"humanReviewed":{"type":"boolean"}}}}},
    "project": {"type":"object","additionalProperties":false,"required":["schema","id","revision","title","createdAt","updatedAt","mode","media","context","observations","bindings","metrics","story","review","releases"],"properties":{"schema":{"const":"courtlens-broadcast/1"},"id":{"$ref":"#/$defs/id"},"revision":{"type":"integer","minimum":0},"title":{"type":"string"},"createdAt":{"type":"string"},"updatedAt":{"type":"string"},"mode":{"enum":["manual","assisted"]},"media":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/media"}]},"context":{"type":"object","additionalProperties":false,"required":["gameId","gameDate","seasonId","seasonType","offenseTeamId","roster"],"properties":{"gameId":{"type":["string","null"]},"gameDate":{"type":["string","null"]},"seasonId":{"type":["string","null"]},"seasonType":{"type":["string","null"]},"offenseTeamId":{"type":["string","null"]},"roster":{"type":"array","items":{"$ref":"#/$defs/player"}}}},"observations":{"type":"array","items":{"$ref":"#/$defs/observation"}},"bindings":{"type":"array","items":{"$ref":"#/$defs/binding"}},"metrics":{"anyOf":[{"type":"null"},{"type":"object","required":["schema"],"properties":{"schema":{"const":"courtlens-metrics/2"}}}]},"story":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/story"}]},"review":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/review"}]},"releases":{"type":"array","items":{"$ref":"#/$defs/release"}}}},
    "capabilities": {"type":"object","additionalProperties":false,"required":["schema","renderer","providers","deployment"],"properties":{"schema":{"const":"courtlens-broadcast-capabilities/1"},"renderer":{"type":"object","additionalProperties":false,"required":["available","ffmpeg","ffprobe","node","font"],"properties":{"available":{"type":"boolean"},"ffmpeg":{"type":"boolean"},"ffprobe":{"type":"boolean"},"node":{"type":"boolean"},"font":{"type":"boolean"}}},"providers":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","kind","configured","available","verified","modalities","mode","reasonCode","message","lastProbeAt","lastProbeResult"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["semantic","cv","voice"]},"configured":{"type":"boolean"},"available":{"type":"boolean"},"verified":{"type":"boolean"},"modalities":{"type":"array","items":{"enum":["text","image","video"]}},"mode":{"type":"string"},"reasonCode":{"type":["string","null"]},"message":{"type":"string"},"lastProbeAt":{"type":["string","null"]},"lastProbeResult":{"enum":["passed","failed","never"]}}}},"upload":{"type":"object","additionalProperties":false,"required":["mode","maxBytes"],"properties":{"mode":{"const":"signed-async"},"maxBytes":{"type":"integer","minimum":1}}},"deployment":{"type":"object","additionalProperties":false,"required":["mode","agentService","region","verified"],"properties":{"mode":{"enum":["local","aws"]},"agentService":{"type":["string","null"]},"region":{"type":["string","null"]},"verified":{"type":"boolean"}}}}}
  },
  "routes": {
    "GET /api/broadcast/v1/capabilities":"capabilities",
    "POST /api/broadcast/v1/providers/:id/probe":{"request":["projectId","expectedRevision","frameId","scope"],"response":"job","status":202},
    "POST /api/broadcast/v1/projects":{"request":["title","mode"],"response":"project","status":201},
    "GET /api/broadcast/v1/projects":{"response":"project summaries"},
    "GET /api/broadcast/v1/projects/:id":{"response":"project"},
    "POST /api/broadcast/v1/projects/:id/media":{"request":"raw bytes; Content-Type, X-Filename, If-Match","response":"project","status":201},
    "POST /api/broadcast/v1/projects/:id/edit":{"request":["expectedRevision","patch"],"response":"project"},
    "POST /api/broadcast/v1/projects/:id/metrics":{"request":["expectedRevision","bundle"],"response":"project"},
    "POST /api/broadcast/v1/projects/:id/frames":{"request":["expectedRevision","times"],"response":"frames"},
    "POST /api/broadcast/v1/projects/:id/analyze":{"request":["expectedRevision","providerId","scope","strategy"],"response":"job","status":202},
    "POST /api/broadcast/v1/projects/:id/cv":{"request":["expectedRevision","providerId","scope"],"response":"job","status":202},
    "POST /api/broadcast/v1/projects/:id/cv/import":{"request":["expectedRevision","result"],"response":"project"},
    "POST /api/broadcast/v1/projects/:id/observations/import":{"request":["expectedRevision","bundle"],"response":"project"},
    "POST /api/broadcast/v1/projects/:id/story":{"request":["expectedRevision","audience","mode","providerId"],"responses":{"template":{"status":200,"data":"project"},"model":{"status":202,"data":"job"}}},
    "POST /api/broadcast/v1/projects/:id/review":{"request":["expectedRevision","actor","checks","note"],"response":"project"},
    "POST /api/broadcast/v1/projects/:id/render":{"request":["expectedRevision","voiceMode","voiceId"],"response":"job","status":202},
    "GET /api/broadcast/v1/jobs/:id":{"response":"job"},
    "POST /api/broadcast/v1/jobs/:id/cancel":{"request":[],"response":"job"},
    "GET /api/broadcast/v1/releases/:id":{"response":"release plus manifest"},
    "GET /api/broadcast/v1/media/:id":{"response":"binary; Range and HEAD"},
    "GET /api/broadcast/v1/frames/:id":{"response":"image"},
    "GET /api/broadcast/v1/releases/:id/:asset":{"assets":["film.mp4","captions.vtt","manifest.json"]}
  }
}
